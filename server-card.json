{
  "name": "lixversion",
  "title": "Lix Agent Version Control",
  "description": "A paid remote MCP for Lix, built to return verdicts, receipts, usage logs, and audit-ready JSON for agent and CI workflows.",
  "version": "1.0.0",
  "websiteUrl": "https://lixversion.clauxel.com/",
  "documentationUrl": "https://lixversion.clauxel.com/mcp/",
  "endpointUrl": "https://lixversion.clauxel.com/mcp",
  "transport": "streamable-http",
  "authentication": {
    "type": "bearer",
    "required": true,
    "header": "Authorization",
    "format": "Bearer <paid-token>"
  },
  "paidAccess": {
    "required": true,
    "checkoutUrl": "https://lixversion.clauxel.com/api/agent-checkout",
    "tokenStatusUrl": "https://lixversion.clauxel.com/api/mcp-token/status",
    "tokenClaimUrl": "https://lixversion.clauxel.com/api/mcp-token/claim",
    "defaultPlan": "team",
    "pricing": [
      {
        "id": "maker",
        "name": "Maker",
        "monthlyUsd": 29
      },
      {
        "id": "team",
        "name": "Team",
        "monthlyUsd": 119
      },
      {
        "id": "studio",
        "name": "Studio",
        "monthlyUsd": 399
      }
    ]
  },
  "tools": [
    {
      "name": "create_agent_change_set",
      "description": "Lix Agent Version Control create agent change set",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sample": {
            "type": "string",
            "description": "Workflow sample, schema, policy fixture, or agent output."
          },
          "context": {
            "type": "string",
            "description": "Optional review context."
          }
        },
        "required": [
          "sample"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "verdict": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "receipt_id": {
            "type": "string"
          },
          "usage_units": {
            "type": "integer"
          },
          "next_action": {
            "type": "string"
          }
        }
      }
    },
